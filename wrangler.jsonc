{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mirai-board-audit-governance-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "preview",
    "APP_NAME": "mirai-board-audit-governance",
    // バックログ B-03: 実メールプロバイダ接続前は既定で "console"（外部送信なし）。
    // 実接続する場合のみ "webhook" にし、EMAIL_WEBHOOK_URL / EMAIL_WEBHOOK_SECRET を
    // `wrangler secret put` で設定する（値はここに書かない）。
    "EMAIL_PROVIDER": "console"
  },
  // バックログ B-09: 四半期アクセス再認証・緊急権限の自動失効を日次で確認する。
  "triggers": {
    "crons": ["0 18 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mirai-board-audit-governance-db",
      "database_id": "d39665c7-db16-4281-9e6d-1a821dd0c8c6",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
